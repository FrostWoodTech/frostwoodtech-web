# Public site content: static data unless set to "false" (then it calls the API below).
VITE_USE_STATIC_DATA=true

VITE_API_BASE_URL=http://localhost:7060/api

VITE_GOOGLE_CLIENT_ID=


# Contact form (Vercel function api/contact.ts) — set these in Vercel, and locally in .env.local for `vercel dev`.
# Use either provider; Brevo wins when both are set.
BREVO_API_KEY=
RESEND_API_KEY=
CONTACT_TO=one@example.com,two@example.com,three@example.com
CONTACT_FROM=FrostWoodTech <enquiries@frostwoodtech.com>
